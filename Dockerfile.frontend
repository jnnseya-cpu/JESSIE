# syntax=docker/dockerfile:1
#
# JESS MOVE site — production image.
#
# Uses Next.js standalone output so the runtime layer is the server, the
# built pages and only the node_modules Next actually traced.

FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /repo

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json        packages/shared/
COPY packages/body-command/package.json  packages/body-command/
COPY packages/foodlens/package.json      packages/foodlens/
COPY apps/frontend/package.json          apps/frontend/

RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /repo
COPY . .
# NEXT_PUBLIC_* is inlined at build time, so the API base URL is a build arg.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @jessmove/shared build \
 && pnpm --filter @jessmove/body-command build \
 && pnpm --filter @jessmove/foodlens build \
 && pnpm --filter @jessmove/frontend build

FROM node:22-alpine AS runtime
RUN corepack enable
ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo

# The whole built workspace. Larger than a standalone bundle, but it is the
# configuration that has actually been verified to serve its own assets.
RUN addgroup -S jm && adduser -S jm -G jm
COPY --from=build --chown=jm:jm /repo ./
USER jm

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=4s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["pnpm", "--filter", "@jessmove/frontend", "start"]
