# ---------------------------------------------------------------------------
# JESS MOVE — environment
#
# Copy to .env and fill in what you have. Nothing here is required to start:
# unconfigured AI providers are skipped, missing SMTP records a message as
# sandbox, and missing Stripe keys make checkout return an explanatory 400
# while the rest of the API keeps working.
#
# Full walkthrough: docs/BACKEND-RUNBOOK.md
# ---------------------------------------------------------------------------

# ---- core ----
PORT=4000
API_PREFIX=api
NODE_ENV=development
# The exact site origin. Scheme included, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# ---- database ----
# Omit for in-memory stores. Nothing survives a restart without it.
DATABASE_URL=

# ---- AI providers ----
# Any subset. Unconfigured providers are skipped rather than failing, so the
# API serves normally with none of these set — only /ai/complete degrades.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
AI_FALLBACK_ORDER=anthropic,openai,gemini

# ---- SMTP ----
# 587 negotiates STARTTLS; 465 is implicit TLS.
# Hostinger: smtp.hostinger.com, port 465, user is the full mailbox address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JESS MOVE <jess@jessmove.com>

# ---- Stripe ----
# The webhook secret from `stripe listen` is NOT the dashboard endpoint's
# secret. They are different values for different environments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One per plan. Set metadata `plan` on each price in Stripe, or invoice.paid
# records the payment and grants no allowance.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_ANNUAL=
STRIPE_PRICE_ORG_SEAT=

# ---- identity and sessions ----
# REQUIRED IN PRODUCTION. Without it registration is silently unavailable,
# which looks exactly like "nobody is signing up". 32+ random bytes.
#   openssl rand -base64 48
AUTH_SECRET=
# Leave unset in development. Set to the apex domain in production so a
# session issued on www is valid on the bare host.
COOKIE_DOMAIN=
# Comma-separated. These addresses get platform_staff on registration;
# every @AdminOnly route is closed to everybody else.
ADMIN_EMAILS=
# `false` opens the demo surfaces to signed-out visitors. It has never
# applied to @AdminOnly and must not be made to.
AUTH_ENFORCE=true
# Development only. Allows an account to be reset without an email round
# trip; leave unset anywhere real.
ALLOW_ACCOUNT_RESET=

# ---- absolute URLs the API builds links with ----
# The webhook URL Stripe must post to is derived from the first of these,
# and password-reset and guardian links from the second. Getting either
# wrong sends people to localhost.
API_PUBLIC_URL=http://localhost:4000/api
SITE_PUBLIC_URL=http://localhost:3000

# ---- scheduled work ----
# REQUIRED for the schedulers to run at all. 16+ characters; the guard
# refuses every request when it is shorter, because an endpoint that
# spends money or pushes notifications must not be open by default.
#   openssl rand -hex 24
# Guards /api/blog/agent/autopilot/cron and /api/nudge/cron.
CRON_SECRET=
# Whether the blog agent may run. Off by default.
SEO_AUTOPILOT=false
SEO_AUTOPILOT_INTERVAL_HOURS=24

# ---- web push ----
# REQUIRED for the platform to speak first. No vendor and no account: the
# keys are yours, generated once, and the browser's own push service does
# the delivery.
#   npx web-push generate-vapid-keys
# Changing them invalidates every existing subscription, so generate once
# and keep them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL a push service can contact you at. Required by
# the VAPID spec; some services reject a JWT without it.
VAPID_SUBJECT=mailto:ops@jessmove.com

# ---- object storage ----
# Vercel Blob. WITHOUT THIS, uploaded images live in one instance's memory
# and disappear when it recycles — profile photos and meal photographs are
# lost, not degraded. Created in the Vercel dashboard under Storage.
BLOB_READ_WRITE_TOKEN=

# ---- wearables (each pair switches one provider on) ----
# Until a pair is set, /wearables/providers names exactly what is missing
# rather than pretending the provider is available.
# Apple Health, Health Connect and Samsung Health are on-device and need
# no keys — they need a native app, which this repository does not have.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Garmin's Health API is OAuth1 behind a partner agreement. There is no
# self-service key; the prefix exists so the code can say so.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# ---- measurement (consent-gated, public marketing pages only) ----
# The two exceptions to the no-new-vendor rule. Never behind the login,
# never on a health surface, never for under-18s, never sent an identity.
# The rules are enforced in packages/shared/src/tracking.ts, not at the
# call sites.
META_PIXEL_ID=
META_CAPI_TOKEN=
GOOGLE_TAG_ID=
GOOGLE_MP_API_SECRET=

# ---- AI cost model ----
# Overrides the per-model rates in packages/shared/src/ai-costs.ts without
# a deploy. JSON, keyed by model id. A zero or negative rate is rejected —
# free AI is the failure that file exists to prevent.
#   {"claude-opus-5":{"gbpPerMillionInput":12,"gbpPerMillionOutput":60}}
AI_TOKEN_RATES_JSON=
AI_REQUEST_TIMEOUT_MS=30000
# How much AI a signed-out visitor may spend on the public demo.
ANONYMOUS_AI_DAILY_LIMIT=

# ---- frontend (build time — inlined, not read at runtime) ----
# NEXT_PUBLIC_* is baked into the bundle at build time. Changing one means
# a rebuild, not a restart.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
