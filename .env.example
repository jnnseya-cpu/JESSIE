# ──────────────────────────────────────────────────────────────
# MOVEQUEST — environment template. Copy to .env and fill in.
# Never commit a populated .env.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Backend ───────────────────────────────────────────────────
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# ── AI Gateway ────────────────────────────────────────────────
# Default provider used when a request does not name one.
# One of: anthropic | openai | gemini
AI_DEFAULT_PROVIDER=anthropic

# Ordered comma-separated fallback chain. If the primary provider
# errors or is not configured, the gateway walks this list.
AI_FALLBACK_ORDER=anthropic,openai,gemini

# Per-request ceiling in milliseconds.
AI_REQUEST_TIMEOUT_MS=120000

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: Azure/proxy base URL
OPENAI_BASE_URL=

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
