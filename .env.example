# ---------------------------------------------------------------------------
# JESS MOVE — environment
#
# Copy to .env and fill in what you have. Nothing here is required to start:
# unconfigured AI providers are skipped, missing SMTP records a message as
# sandbox, and missing Stripe keys make checkout return an explanatory 400
# while the rest of the API keeps working.
#
# Full walkthrough: docs/BACKEND-RUNBOOK.md
# ---------------------------------------------------------------------------

# ---- core ----
PORT=4000
API_PREFIX=api
NODE_ENV=development
# The exact site origin. Scheme included, no trailing slash.
CORS_ORIGINS=http://localhost:3000

# ---- database ----
# Omit for in-memory stores. Nothing survives a restart without it.
DATABASE_URL=

# ---- AI providers ----
# Any subset. Unconfigured providers are skipped rather than failing, so the
# API serves normally with none of these set — only /ai/complete degrades.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic
AI_FALLBACK_ORDER=anthropic,openai,gemini

# ---- SMTP ----
# 587 negotiates STARTTLS; 465 is implicit TLS.
# Hostinger: smtp.hostinger.com, port 465, user is the full mailbox address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JESS MOVE <no-reply@jessmove.com>

# ---- Stripe ----
# The webhook secret from `stripe listen` is NOT the dashboard endpoint's
# secret. They are different values for different environments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One per plan. Set metadata `plan` on each price in Stripe, or invoice.paid
# records the payment and grants no allowance.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_ANNUAL=
STRIPE_PRICE_ORG_SEAT=

# ---- frontend (build time — inlined, not read at runtime) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
