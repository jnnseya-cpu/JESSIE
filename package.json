{
  "name": "jessie-os",
  "version": "1.0.0",
  "private": true,
  "description": "JESSIE-OS™ — Just Enough Somatic Stimulus Intelligence Engine",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @jessie-os/shared build && pnpm --filter @jessie-os/backend build && pnpm --filter @jessie-os/frontend build",
    "build:shared": "pnpm --filter @jessie-os/shared build",
    "build:backend": "pnpm --filter @jessie-os/backend build",
    "build:frontend": "pnpm --filter @jessie-os/frontend build",
    "dev": "pnpm --parallel --filter @jessie-os/backend --filter @jessie-os/frontend dev",
    "dev:backend": "pnpm --filter @jessie-os/backend dev",
    "dev:frontend": "pnpm --filter @jessie-os/frontend dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "rm -rf packages/*/dist apps/backend/dist apps/frontend/.next node_modules/.cache"
  }
}
