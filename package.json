{
  "name": "jessmove",
  "version": "1.0.0",
  "private": true,
  "description": "JESS MOVE™ — Just Enough Somatic Stimulus Intelligence Engine",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm --filter @jessmove/shared build && pnpm --filter @jessmove/backend build && pnpm --filter @jessmove/frontend build",
    "build:backend": "pnpm --filter @jessmove/backend build",
    "build:body-command": "pnpm --filter @jessmove/body-command build",
    "build:foodlens": "pnpm --filter @jessmove/foodlens build",
    "build:frontend": "pnpm --filter @jessmove/frontend build",
    "build:shared": "pnpm --filter @jessmove/shared build",
    "clean": "rm -rf packages/*/dist apps/backend/dist apps/frontend/.next node_modules/.cache",
    "db:migrate": "node scripts/db-apply.mjs migrate",
    "db:test": "node scripts/db-apply.mjs test",
    "verify:money": "node scripts/verify-money.mjs",
    "dev": "pnpm --parallel --filter @jessmove/backend --filter @jessmove/frontend dev",
    "dev:backend": "pnpm --filter @jessmove/backend dev",
    "dev:frontend": "pnpm --filter @jessmove/frontend dev",
    "docker:up": "docker compose up --build",
    "docs:sales": "node scripts/build-sales-docx.js",
    "economics": "node --experimental-strip-types scripts/economics-report.mjs",
    "smoke": "bash scripts/smoke.sh",
    "start:backend": "node apps/backend/dist/main.js",
    "start:frontend": "pnpm --filter @jessmove/frontend start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "docs:ads": "node scripts/build-ads-docx.js"
  },
  "devDependencies": {
    "@jessmove/shared": "workspace:*",
    "docx": "^9.7.1"
  }
}
