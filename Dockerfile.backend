# syntax=docker/dockerfile:1
#
# JESS MOVE API — production image.
#
# Multi-stage so the runtime layer carries no toolchain and no sources.
# pnpm workspace aware: the workspace manifests are copied before the
# sources so a dependency install is cached across code changes.

# ---------- on the Node tag ----------
#
# `node:22-alpine` is deliberately the major tag and not an exact patch.
#
# A rebuild with `--pull` resolves it to the newest 22.x, so a security
# release arrives by rebuilding and keeps arriving. Pinning
# `node:22.23.4-alpine` looks more rigorous and is worse: it freezes the
# runtime at one patch level, and the next fix has to be noticed by a
# person editing this line.
#
# What the tag does not do is update an image that already exists. A built
# image carries whatever 22.x it was built against for ever. After a Node
# security release the images have to be rebuilt:
#
#   docker compose pull && docker compose build --pull && docker compose up -d
#
# October 2026: the fixed releases are 22.23.4, 24.22.1 and 26.12.1, and
# the worst of the faults they fix allows code execution on the server.
# Node 20 and earlier are end of life and will not be fixed —
# `engines.node` is set above them so a tool reading it says so.

# ---------- deps ----------
FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /repo

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json        packages/shared/
COPY packages/body-command/package.json  packages/body-command/
COPY packages/foodlens/package.json      packages/foodlens/
COPY apps/backend/package.json           apps/backend/

RUN pnpm install --frozen-lockfile

# ---------- build ----------
FROM deps AS build
WORKDIR /repo
COPY . .
RUN pnpm --filter @jessmove/shared build \
 && pnpm --filter @jessmove/body-command build \
 && pnpm --filter @jessmove/foodlens build \
 && pnpm --filter @jessmove/backend build \
 && pnpm --filter @jessmove/backend --prod deploy /out

# ---------- runtime ----------
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
# Cloud Run and most PaaS inject PORT; 4000 is the local default.
ENV PORT=4000
WORKDIR /app

# Never run as root.
RUN addgroup -S jm && adduser -S jm -G jm
COPY --from=build --chown=jm:jm /out ./
USER jm

EXPOSE 4000

# The container is unhealthy if the API cannot answer its own health check.
HEALTHCHECK --interval=30s --timeout=4s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/'+(process.env.API_PREFIX||'api')+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
